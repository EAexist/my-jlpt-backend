{
    "openapi": "3.0.0",
    "info": {
        "title": "JLPT API",
        "version": "1.0.0",
        "description": "API specification for the JLPT learning platform."
    },
    "servers": [
        {
            "url": "/api/v1"
        }
    ],
    "components": {
        "securitySchemes": {
            "bearer": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        },
        "schemas": {
            "ApiError": {
                "type": "object",
                "properties": {
                    "detail": {
                        "type": "string"
                    }
                },
                "required": [
                    "detail"
                ]
            },
            "User": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string",
                        "nullable": true
                    },
                    "name": {
                        "type": "string",
                        "nullable": true
                    },
                    "image": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "required": [
                    "id",
                    "email"
                ]
            },
            "Group": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "contentCount": {
                        "type": "integer"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "contentCount"
                ]
            },
            "JLPTLevel": {
                "type": "string",
                "enum": [
                    "N1",
                    "N2",
                    "N3",
                    "N4",
                    "N5"
                ]
            },
            "FuriganaToken": {
                "type": "object",
                "properties": {
                    "text": {
                        "type": "string"
                    },
                    "reading": {
                        "type": "string"
                    }
                },
                "required": [
                    "text",
                    "reading"
                ]
            },
            "GrammarPattern": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "explanation": {
                        "type": "string"
                    },
                    "examples": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "tokens": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/FuriganaToken"
                                    }
                                },
                                "translation": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "required": [
                    "id",
                    "name",
                    "description",
                    "explanation",
                    "examples"
                ]
            },
            "Sentence": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "tokens": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/FuriganaToken"
                        }
                    },
                    "translation": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "tokens",
                    "translation"
                ]
            },
            "Section": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "sentences": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Sentence"
                        }
                    },
                    "level": {
                        "$ref": "#/components/schemas/JLPTLevel"
                    },
                    "grammar_patterns": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/GrammarPattern"
                        }
                    },
                    "vocabularies": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/VocabularyItem"
                        }
                    }
                },
                "required": [
                    "id",
                    "sentences",
                    "level",
                    "grammar_patterns",
                    "vocabularies"
                ]
            },
            "VocabularyItem": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "tokens": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/FuriganaToken"
                        }
                    },
                    "level": {
                        "$ref": "#/components/schemas/JLPTLevel"
                    },
                    "translation": {
                        "type": "string"
                    },
                    "synonyms": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "id",
                    "tokens",
                    "level",
                    "translation",
                    "synonyms"
                ]
            },
            "BaseContent": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "PENDING",
                            "PROCESSING",
                            "COMPLETED",
                            "FAILED"
                        ]
                    },
                    "created_at": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "status",
                    "created_at",
                    "title"
                ]
            },
            "ProcessingContent": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/BaseContent"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "progress": {
                                "type": "number"
                            },
                            "current_step": {
                                "type": "string"
                            },
                            "estimated_completion_time": {
                                "type": "string",
                                "nullable": true
                            },
                            "status": {
                                "type": "string",
                                "enum": [
                                    "PENDING",
                                    "PROCESSING"
                                ]
                            }
                        },
                        "required": [
                            "progress",
                            "current_step",
                            "status"
                        ]
                    }
                ]
            },
            "FailedContent": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/BaseContent"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "error_message": {
                                "type": "string"
                            },
                            "status": {
                                "type": "string",
                                "enum": [
                                    "FAILED"
                                ]
                            }
                        },
                        "required": [
                            "error_message",
                            "status"
                        ]
                    }
                ]
            },
            "CompletedContent": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/BaseContent"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "overall_level": {
                                "$ref": "#/components/schemas/JLPTLevel"
                            },
                            "sections": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/Section"
                                }
                            },
                            "vocabulary": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/VocabularyItem"
                                }
                            },
                            "status": {
                                "type": "string",
                                "enum": [
                                    "COMPLETED"
                                ]
                            }
                        },
                        "required": [
                            "overall_level",
                            "sections",
                            "vocabulary",
                            "status"
                        ]
                    }
                ]
            },
            "Content": {
                "oneOf": [
                    {
                        "$ref": "#/components/schemas/ProcessingContent"
                    },
                    {
                        "$ref": "#/components/schemas/FailedContent"
                    },
                    {
                        "$ref": "#/components/schemas/CompletedContent"
                    }
                ]
            },
            "CreateContentRequest": {
                "type": "object",
                "properties": {
                    "text": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "required": [
                    "text"
                ]
            }
        }
    },
    "security": [
        {
            "bearer": []
        }
    ],
    "paths": {
        "/health": {
            "get": {
                "summary": "Get health status",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/auth/sync": {
            "post": {
                "summary": "Sync user auth data",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "provider": {
                                        "type": "string"
                                    },
                                    "providerAccountId": {
                                        "type": "string"
                                    },
                                    "email": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "name": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "image": {
                                        "type": "string",
                                        "nullable": true
                                    }
                                },
                                "required": [
                                    "provider",
                                    "providerAccountId"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/User"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/auth/me": {
            "get": {
                "summary": "Get current user",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/User"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/content": {
            "get": {
                "summary": "List content",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Content"
                                            }
                                        },
                                        "meta": {
                                            "type": "object",
                                            "properties": {
                                                "total": {
                                                    "type": "integer"
                                                },
                                                "page": {
                                                    "type": "integer"
                                                },
                                                "limit": {
                                                    "type": "integer"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "summary": "Create content",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateContentRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProcessingContent"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Unprocessable Entity",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/content/{id}": {
            "get": {
                "summary": "Get content by ID",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Content"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "summary": "Update content",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "groupId": {
                                        "type": "string",
                                        "nullable": true
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Content"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "summary": "Delete content",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    }
                }
            }
        },
        "/groups": {
            "get": {
                "summary": "Fetch all groups",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Group"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "summary": "Create a group",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "name"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Group"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/groups/{groupId}": {
            "get": {
                "summary": "Fetch group by ID",
                "parameters": [
                    {
                        "name": "groupId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Group"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/groups/{groupId}/content": {
            "get": {
                "summary": "Fetch contents for group",
                "parameters": [
                    {
                        "name": "groupId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Content"
                                            }
                                        },
                                        "meta": {
                                            "type": "object",
                                            "properties": {
                                                "total": {
                                                    "type": "integer"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/groups/{groupId}/content/{contentId}": {
            "delete": {
                "summary": "Remove content from group",
                "parameters": [
                    {
                        "name": "groupId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "contentId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    }
                }
            }
        }
    }
}