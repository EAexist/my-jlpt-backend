// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  AWAITING_UPLOAD
  CONFIRMED
  EXPIRED
}

model Learner {
  id                String   @id @default(uuid())
  provider          String
  providerAccountId String
  email             String?
  name              String?
  avatarUrl         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  groups            Group[]

  @@unique([provider, providerAccountId])
}

model Group {
  id        String    @id @default(uuid())
  ownerId   String
  name      String
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  learner   Learner   @relation(fields: [ownerId], references: [id])
  contents  Content[]

  @@index([ownerId])
}

model Content {
  id                 String          @id @default(uuid())
  ownerId            String
  groupId            String
  title              String
  lexical            Json?
  inputFileObjectKey String?
  inputFileName      String?
  inputMimeType      String?
  status             ContentStatus   @default(PENDING)
  overallLevel       Int?
  errorMessage       String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  group              Group           @relation(fields: [groupId], references: [id])
  processingJob      ProcessingJob?
  sections           Section[]
  uploadedFiles      UploadedFile[]

  @@index([ownerId])
  @@index([groupId])
  @@index([status, createdAt])
}

model ProcessingJob {
  id               String        @id @default(uuid())
  contentId        String        @unique
  status           ContentStatus
  progress         Int           @default(0)
  currentStep      String?
  externalTaskName String?
  attemptCount     Int           @default(0)
  idempotencyKey   String        @unique
  startedAt        DateTime?
  completedAt      DateTime?
  failedAt         DateTime?
  errorMessage     String?
  content          Content       @relation(fields: [contentId], references: [id])
}

model Section {
  id              String           @id @default(uuid())
  contentId       String
  lexical         Json
  translation     String
  level           Int?
  content         Content          @relation(fields: [contentId], references: [id])
  grammarPatterns GrammarPattern[]
  vocabularyItems VocabularyItem[]

  @@index([contentId])
}

model GrammarPattern {
  id                  String             @id @default(uuid())
  name                String             @unique
  level               Int?
  description         String
  grammarExamples     GrammarExample[]
  sections            Section[]
}

model GrammarExample {
  id               String         @id @default(uuid())
  grammarPatternId String
  lexical          Json
  translation      String
  grammarPattern   GrammarPattern @relation(fields: [grammarPatternId], references: [id])

  @@index([grammarPatternId])
}

model VocabularyItem {
  id             String     @id @default(uuid())
  lexical        Json
  level          Int?
  translation    String
  synonyms       String[]
  examplePhrases String[]
  sections       Section[]

  // Note: Unique constraint not supported on Json fields
}

model UploadedFile {
  id                 String        @id @default(uuid())
  contentId          String?
  ownerId            String
  objectKey          String
  originalName       String
  mimeType           String
  sizeBytes          Int?
  status             ContentStatus @default(AWAITING_UPLOAD)
  signedUrlExpiresAt DateTime?
  createdAt          DateTime      @default(now())
  content            Content?      @relation(fields: [contentId], references: [id])

  @@index([ownerId])
}
